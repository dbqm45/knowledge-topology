# Copy to .env and adjust. All variables are optional; defaults work for a local demo.

# --- Storage (local Python run without Docker uses SQLite + a local vector file) ---
# KT_DATABASE_URL=sqlite:///./data/kt.db
# KT_VECTOR_BACKEND=local                # local | qdrant
# KT_QDRANT_URL=http://127.0.0.1:6333
# KT_DATA_DIR=./data

# --- Embeddings ---
# hashing = dependency-free demo embedder; for real use: sentence-transformers + BAAI/bge-m3 (local, private)
# KT_EMBEDDING_PROVIDER=hashing
# KT_EMBEDDING_MODEL=BAAI/bge-m3
# KT_EMBEDDING_DIM=768
# KT_OPENAI_API_KEY=
# Changing the embedding model requires a full re-index: kt sync --full

# --- Retrieval calibration (depends on the embedding model) ---
# KT_RETRIEVAL_VECTOR_ONLY_MIN=0.3
# KT_CONTEXT_BUDGET_TOKENS=2500

# --- Reranker (second stage over the fused candidates; local, pip install -e ".[rerank]") ---
# KT_RERANKER=none                       # none | cross-encoder
# KT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # multilingual (PL/EN); lighter EN: cross-encoder/ms-marco-MiniLM-L-6-v2
# KT_RERANKER_CANDIDATES=30
# KT_RERANKER_MIN_SCORE=0.05             # drop passages the cross-encoder considers irrelevant
# KT_RERANKER_DEVICE=cpu

# --- Auth ---
# API keys file (JSON: key -> {principal, groups, roles}); default: $KT_DATA_DIR/api-keys.json
# KT_API_KEYS_FILE=./data/api-keys.json
# Identity used by the MCP server (an API key from the file above)
# KT_MCP_API_KEY=dev-agent-key
# Shared secret for /api/v1/webhooks/confluence/{source_id} (header X-KT-Webhook-Secret)
# KT_WEBHOOK_SECRET=

# --- Confluence Cloud (token is read from this variable, never stored in the DB) ---
# CONFLUENCE_API_TOKEN=

# --- docker compose ---
# POSTGRES_PASSWORD=kt
# KT_DOCS_DIR=./demo                     # host folder mounted read-only at /docs
# KT_WORKER_INTERVAL=900
